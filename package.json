{
  "name": "bb-plugin-model-filter",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.47.1 <0.48.0",
    "bbPluginSdk": ">=0.6.79 <0.7.0"
  },
  "bb": {
    "name": "Model Filter",
    "description": "Show only the models you choose in BB’s standard model pickers.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.79",
    "@tanstack/query-core": "5.105.0",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.47.1",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^26.1.0",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "better-sqlite3": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "bb plugin build",
    "check:sdk": "node scripts/check-sdk.mjs",
    "format:check": "prettier --check \"*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{md,json}\" \"skills/**/*.md\" \".github/**/*.yml\"",
    "format": "prettier --write \"*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{md,json}\" \"skills/**/*.md\" \".github/**/*.yml\""
  },
  "private": true,
  "license": "UNLICENSED",
  "description": "Choose visible models in BB standard model pickers.",
  "files": [
    "dist/",
    "*.ts",
    "*.tsx",
    "*.css",
    "assets/",
    "components/",
    "lib/",
    "skills/",
    "scripts/",
    "docs/",
    "tsconfig.json",
    "LICENSE",
    "CHANGELOG.md",
    "PLUGIN_OVERVIEW.md"
  ]
}
